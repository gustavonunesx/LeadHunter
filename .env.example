# Copie para .env e preencha no seu computador. Nunca envie o .env pelo chat nem para o Git.

# Busca de empresas (DataForSEO): login e senha da API, em app.dataforseo.com > API Access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Classificação de nicho com Jev (opcional; sem chave usa regras locais)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Limites de chamadas pagas de busca
MAX_CALLS_PER_CAMPAIGN=80
MAX_CALLS_PER_DAY=200

# Prévias de site
# SITE_ENGINE: claude_code (usa sua assinatura Claude via Claude Code), offline (textos padrão, sem IA)
#              ou api (créditos da API Anthropic; ainda não implementado)
SITE_ENGINE=claude_code
SITE_MODEL=claude-opus-5-5
SITE_EFFORT=high
SITE_TIMEOUT=900
MAX_SITES_PER_DAY=20
# Caminho do Claude Code, se não for encontrado automaticamente (PATH ou extensão do VS Code)
CLAUDE_CODE_PATH=
