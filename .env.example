# Copie para .env e preencha no seu computador. Nunca commite o .env.

# DataForSEO (coleta Google Maps e busca orgânica) — obrigatório para coleta real
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# TypeSafe/Jev (classificação de nicho) — opcional; sem chave usa regras locais
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Limites de chamadas externas
MAX_CALLS_PER_CAMPAIGN=80
MAX_CALLS_PER_DAY=200
